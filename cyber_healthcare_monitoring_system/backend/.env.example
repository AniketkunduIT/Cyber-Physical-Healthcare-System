# Application Configuration
APP_NAME=Cyber Physical Healthcare System
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security and JWT
SECRET_KEY=cyber_healthcare_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./cyber_healthcare.db

# Storage Directories
UPLOAD_AUDIO_DIR=uploads/audio
UPLOAD_PRESCRIPTION_DIR=uploads/prescriptions
MAX_AUDIO_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=*
